# Salin file ini menjadi .env lalu sesuaikan.  cp .env.example .env

# Nama situs & alamat
SITE_NAME=VaresaJasher
PORT=3000
HOST=0.0.0.0
# Alamat publik website (tanpa / di akhir), misalnya https://jasher.varesa.mom
BASE_URL=

# Email yang otomatis jadi admin (pisahkan dengan koma). WAJIB diisi.
ADMIN_EMAILS=email-kamu@gmail.com

# Isi 1 kalau website dijalankan di belakang Nginx / Cloudflare (HTTPS)
TRUST_PROXY=0
# Paksa cookie hanya lewat HTTPS (kosongkan = otomatis)
COOKIE_SECURE=

# Login dengan Google (opsional). Buat OAuth Client ID tipe "Web application"
# di Google Cloud Console, tambahkan domain kamu ke "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Folder database & data bot (sesi WhatsApp, whitelist, gambar AutoJPM)
STORAGE_DIR=storage

# 1 = bot TIDAK tersambung ke WhatsApp, hanya pura-pura pairing.
# Pakai untuk mencoba tampilan website. Untuk dipakai sungguhan: 0
BOT_SIMULASI=0

# Batas memori tiap bot (MB) & lama menunggu pairing (menit)
BOT_MAX_MEMORY_MB=300
PAIRING_TIMEOUT_MINUTES=4

# Lama login di browser (hari)
SESSION_DAYS=30

# (Opsional) simpan gambar AutoJPM di repo GitHub. Kosongkan = disimpan di disk.
# JANGAN pernah menulis token di kode atau mem-push file .env ke GitHub.
GITHUB_TOKEN=
GITHUB_USERNAME=
GITHUB_REPO=
GITHUB_BRANCH=main

# --- Pembayaran QRIS otomatis (AutoGopay) ---
# Kosongkan API key = hanya top up manual (alur lama tetap jalan).
# Daftarkan URL webhook  <BASE_URL>/api/payment/webhook  di dashboard AutoGopay.
# JANGAN menulis API key di kode / mem-push .env.
AUTOGOPAY_API_KEY=
AUTOGOPAY_BASE_URL=https://v1-gateway.autogopay.site
# Biaya admin QRIS awal (Rp, flat). Setelah itu diatur dari panel admin.
QRIS_FEE=200
# 1 = gateway palsu untuk uji coba lokal. Diabaikan kalau AUTOGOPAY_API_KEY diisi.
AUTOGOPAY_SIMULASI=0
